{
  "providers": {
    "claude": {
      "label": "Claude",
      "kind": "subscription",
      "enabled": true,
      "quota": {
        "source": "claude-statusline"
      },
      "tos": "official-cli",
      "trainsOnData": false
    },
    "codex": {
      "label": "ChatGPT/Codex",
      "kind": "subscription",
      "enabled": true,
      "quota": {
        "source": "codex-logs"
      },
      "worker": "codex-worker",
      "tos": "official-cli",
      "trainsOnData": false
    },
    "perplexity": {
      "label": "Perplexity",
      "kind": "manual",
      "enabled": true,
      "quota": {
        "source": "none"
      },
      "worker": "researcher",
      "tos": "avoid",
      "trainsOnData": false
    },
    "grok": {
      "evidence": "docs",
      "label": "Grok",
      "kind": "subscription",
      "enabled": false,
      "quota": {
        "source": "counter",
        "windows": {
          "weekly": {
            "budget": 200,
            "unit": "calls"
          }
        }
      },
      "worker": "cli-worker",
      "cli": {
        "command": "grok",
        "args": [
          "-p",
          "{prompt}",
          "--allow",
          "Edit",
          "-m",
          "{model}",
          "--effort",
          "{effort}"
        ],
        "defaultModel": "grok-4.7"
      },
      "tos": "official-cli",
      "trainsOnData": false
    },
    "devin": {
      "evidence": "docs",
      "label": "Devin (Cognition, free model)",
      "kind": "free",
      "enabled": false,
      "quota": {
        "source": "none"
      },
      "worker": "cli-worker",
      "cli": {
        "$comment": "Only SWE-2 Flash Medium is free; every other Devin model bills per token, so the free model is always named. Print mode cannot show the workspace trust prompt and fails without that switch. accept-edits lets it edit files without asking; shell commands are refused in print mode. settleMinutes stops it once its edits have stayed the same for 5 minutes, because it can keep running for half an hour after the work is written.",
        "command": "devin",
        "args": [
          "--respect-workspace-trust",
          "false",
          "--permission-mode",
          "accept-edits",
          "--model",
          "swe-2-flash-medium",
          "-p",
          "{prompt}"
        ],
        "settleMinutes": 5
      },
      "tos": "official-cli",
      "trainsOnData": true
    },
    "copilot": {
      "label": "GitHub Copilot",
      "maxParallel": 2,
      "kind": "subscription",
      "enabled": false,
      "quota": {
        "source": "counter",
        "windows": {
          "monthly": {
            "budget": 200,
            "unit": "credits"
          }
        }
      },
      "worker": "cli-worker",
      "cli": {
        "command": "copilot",
        "args": [
          "-p",
          "{prompt}",
          "-s",
          "--no-ask-user",
          "--allow-tool=write",
          "--disable-builtin-mcps",
          "--max-ai-credits",
          "30",
          "--model",
          "{model}",
          "--reasoning-effort",
          "{effort}"
        ],
        "defaultModel": "auto"
      },
      "tos": "official-cli",
      "trainsOnData": false
    },
    "antigravity": {
      "evidence": "docs",
      "label": "Google Antigravity (Gemini)",
      "kind": "subscription",
      "enabled": false,
      "quota": {
        "source": "none"
      },
      "worker": "cli-worker",
      "cli": {
        "$comment": "Auto mode lets edits run without a settings file; without it they are soft-denied and the run still exits 0.",
        "command": "agy",
        "args": [
          "-p",
          "{prompt}",
          "--mode",
          "auto",
          "--model",
          "{model}-{effort}"
        ],
        "defaultModel": "gemini-3.8-flash",
        "defaultEffort": "medium",
        "tools": [
          "web-search"
        ]
      },
      "tos": "official-cli",
      "trainsOnData": false
    },
    "gemini-media": {
      "evidence": "docs",
      "label": "Gemini media (gemini-api CLI, free)",
      "kind": "free",
      "enabled": false,
      "quota": {
        "source": "none"
      },
      "worker": "cli-worker",
      "cli": {
        "$comment": "Google's stateless Gemini API CLI: one call, answer on stdout, reads only the --input file or public YouTube URL. Needs GEMINI_API_KEY. Free tier: Google may use prompts to improve its products outside the EEA, UK and Switzerland.",
        "command": "gemini-api",
        "args": [
          "analyze",
          "{prompt}",
          "-m",
          "{model}",
          "-i",
          "{input}"
        ],
        "defaultModel": "gemini-3.8-flash",
        "inputs": [
          "image",
          "pdf",
          "video",
          "audio"
        ]
      },
      "tos": "official-cli",
      "trainsOnData": true
    },
    "junie-lite": {
      "evidence": "docs",
      "label": "Junie Lite (JetBrains, free)",
      "kind": "free",
      "enabled": false,
      "quota": {
        "source": "none"
      },
      "worker": "cli-worker",
      "cli": {
        "$comment": "The account default model uses paid credits, so the free model is always named. The task comes on stdin.",
        "command": "junie",
        "promptVia": "stdin",
        "args": [
          "--input-format=text",
          "--output-format=json",
          "--skip-update-check",
          "--model=junie-lite"
        ]
      },
      "tos": "official-cli",
      "trainsOnData": false
    },
    "jetbrains": {
      "evidence": "docs",
      "label": "JetBrains AI (Junie)",
      "kind": "subscription",
      "enabled": false,
      "quota": {
        "source": "none"
      },
      "worker": "cli-worker",
      "cli": {
        "$comment": "The task comes on stdin.",
        "command": "junie",
        "promptVia": "stdin",
        "args": [
          "--input-format=text",
          "--output-format=json",
          "--skip-update-check",
          "--model={model}",
          "--effort={effort}"
        ],
        "defaultModel": "gpt-6-luna"
      },
      "tos": "official-cli",
      "trainsOnData": false
    },
    "kilo-free": {
      "label": "Kilo Free",
      "kind": "free",
      "enabled": false,
      "trainsOnData": true,
      "tos": "official-cli",
      "worker": "cli-worker",
      "quota": {
        "source": "none"
      },
      "cli": {
        "command": "kilo",
        "args": [
          "run",
          "-m",
          "kilo/kilo-auto/free",
          "{prompt}"
        ]
      }
    },
    "ollama": {
      "label": "Ollama local (example)",
      "kind": "local",
      "enabled": false,
      "trainsOnData": false,
      "tos": "official-cli",
      "worker": "cli-worker",
      "quota": {
        "source": "none"
      },
      "cli": {
        "$comment": "Replace <model> with an installed local model before enabling.",
        "command": "ollama",
        "args": [
          "run",
          "<model>",
          "{prompt}"
        ]
      }
    }
  },
  "caps": {}
}
